# Supabase project (Project Settings → API). The publishable key is safe in the browser;
# never put the secret / service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Web Push public key (generated with `npx web-push generate-vapid-keys`)
VITE_VAPID_PUBLIC_KEY=

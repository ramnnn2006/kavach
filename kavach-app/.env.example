# Supabase project (Project Settings → API). The publishable key is safe in the browser;
# never put the secret / service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Web Push (VAPID) public key — `npx web-push generate-vapid-keys --json`. Only the PUBLIC key goes here;
# the private key lives in Supabase Vault (see supabase/migrations/20261008001100_notifications.sql).
VITE_VAPID_PUBLIC_KEY=
